<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  catch_discover_tests запускает каждый кейс отдельным процессом, передавая имя
  теста аргументом. На Windows системная ANSI-кодепейдж (1252 на раннерах)
  не содержит кириллицы, и UCRT превращает аргументы в «?» — Catch2 отвечает
  «No test cases matched», и все кейсы «падают» за 0.01 с.

  activeCodePage=UTF-8 (Windows 10 1903+) переключает узкие преобразования CRT,
  включая разбор командной строки, на UTF-8: имена кейсов доходят целиком.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
