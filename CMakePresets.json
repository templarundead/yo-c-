{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-clang-debug",
      "displayName": "Windows clang-cl Debug (GUI + CLI + tests)",
      "description": "Основной preset для разработки под Windows. clang-cl, C++23, /W4 /permissive- /WX, ASan+UBSan.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-clang-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "YO_BUILD_GUI": "ON",
        "YO_BUILD_CLI": "ON",
        "YO_BUILD_TESTS": "ON",
        "YO_BUILD_BENCH": "OFF",
        "YO_SANITIZERS": "ON",
        "YO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "win-clang-release",
      "displayName": "Windows clang-cl Release (GUI + CLI)",
      "description": "Релизная сборка для поставки. /O2, без санитайзеров.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-clang-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23",
        "YO_BUILD_GUI": "ON",
        "YO_BUILD_CLI": "ON",
        "YO_BUILD_TESTS": "OFF",
        "YO_BUILD_BENCH": "OFF",
        "YO_SANITIZERS": "OFF",
        "YO_WARNINGS_AS_ERRORS": "ON",
        "YO_STATIC_RUNTIME": "ON",
        "YO_LTO": "ON"
      }
    },
    {
      "name": "win-clang-bench",
      "displayName": "Windows clang-cl Release + benchmarks",
      "description": "Бенчмарки ёфикации/поиска/открытия на 1 МБ / 100 МБ / 1 ГБ.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-clang-bench",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23",
        "YO_BUILD_GUI": "OFF",
        "YO_BUILD_CLI": "ON",
        "YO_BUILD_TESTS": "OFF",
        "YO_BUILD_BENCH": "ON",
        "YO_SANITIZERS": "OFF",
        "YO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux clang Debug (core + CLI + tests, без GUI)",
      "description": "CI для ядра: core собирается без Win32, тесты и CLI — на Linux.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_COMPILER": "clang++",
        "YO_BUILD_GUI": "OFF",
        "YO_BUILD_CLI": "ON",
        "YO_BUILD_TESTS": "ON",
        "YO_BUILD_BENCH": "OFF",
        "YO_SANITIZERS": "ON",
        "YO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux clang Release (core + CLI, LTO, strip)",
      "description": "Релизная сборка Linux-артефактов: без санитайзеров, LTO, strip. Прежний релиз собирался на debug-пресете и уезжал к пользователям с ASan.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_COMPILER": "clang++",
        "YO_BUILD_GUI": "OFF",
        "YO_BUILD_CLI": "ON",
        "YO_BUILD_TESTS": "ON",
        "YO_BUILD_BENCH": "OFF",
        "YO_SANITIZERS": "OFF",
        "YO_WARNINGS_AS_ERRORS": "ON",
        "YO_LTO": "ON",
        "YO_STRIP": "ON"
      }
    },
    {
      "name": "win-msvc-release",
      "displayName": "Windows MSVC Release (совместимость)",
      "description": "Проверка сборки MSVC (без clang-cl) для CI-матрицы. LTO здесь выключен намеренно: /GL+/LTCG у MSVC — отдельная ветка линковки, её проверяет релизный пресет clang-cl.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23",
        "YO_BUILD_GUI": "ON",
        "YO_BUILD_CLI": "ON",
        "YO_BUILD_TESTS": "OFF",
        "YO_BUILD_BENCH": "OFF",
        "YO_SANITIZERS": "OFF",
        "YO_WARNINGS_AS_ERRORS": "ON",
        "YO_STATIC_RUNTIME": "ON",
        "YO_LTO": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-clang-debug", "configurePreset": "win-clang-debug" },
    { "name": "win-clang-release", "configurePreset": "win-clang-release" },
    { "name": "win-clang-bench", "configurePreset": "win-clang-bench" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "win-msvc-release", "configurePreset": "win-msvc-release" }
  ],
  "testPresets": [
    { "name": "win-clang-debug", "configurePreset": "win-clang-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "output": { "outputOnFailure": true } }
  ]
}
